{
  "compilerOptions": {
    "pretty": true,
    "lib": ["ES2022"],
    "target": "ES2022",
    "moduleResolution": "node",
    "module": "commonjs",
    "strict": true,
    "types": ["node", "jest"],
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}
