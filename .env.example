# Docker Compose reads this file after copying it to .env.
PORT=4000
ALLOWED_ORIGINS=http://localhost:4000
# Native Node startup: DATA_DIR=./data (private room/account checkpoints).
# Vite defaults to the same-origin /graphql endpoint. For split hosting, set
# VITE_API_URL in skull-king-web/.env.local before building the client, and
# include the frontend's exact origin in ALLOWED_ORIGINS on the server.
